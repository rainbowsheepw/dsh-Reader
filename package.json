{
  "name": "@rainbowsheepw/dsh-reader",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 阅读器插件：宫格书架 + PDF 精读。文字层标注（精确到字）、四色高亮、阅读进度与缩放记忆、AI 全书框架、选中文字提问。",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "vendor/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "reader",
    "pdf",
    "bookshelf",
    "annotation",
    "pdfjs",
    "study"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node scripts/run-all.mjs",
    "check:syntax": "node --check index.js && node --check client.js && node --check lib/store.js && node --check lib/http.js && node --check lib/llm.js && node --check lib/paths.js && node --check lib/book-text.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rainbowsheepw/dsh-reader.git"
  },
  "bugs": {
    "url": "https://github.com/rainbowsheepw/dsh-reader/issues"
  },
  "homepage": "https://github.com/rainbowsheepw/dsh-reader#readme"
}
